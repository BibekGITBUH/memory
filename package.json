{
  "name": "universal-mcp-memory-server",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-auth remote MCP memory server with JSON-file persistence",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "stdio": "tsx src/stdio.ts",
    "test": "vitest run --exclude \"**/dist/**\"",
    "test:watch": "vitest --exclude \"**/dist/**\"",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.14",
    "proper-lockfile": "4.1.2",
    "undici": "7.30.1",
    "write-file-atomic": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/write-file-atomic": "4.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
