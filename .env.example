# Copy this file to .env and replace every CHANGE_ME value.
# Node.js 20.19+ (Node 22 LTS recommended).

PORT=3000
HOST=127.0.0.1
# Local only until a tunnel hostname is known. Set to the exact HTTPS origin after starting Cloudflare Tunnel.
PUBLIC_BASE_URL=http://127.0.0.1:3000
# URL of the frontend SPA (Vite default: http://localhost:5173). Used for CORS and OAuth consent redirects.
FRONTEND_URL=http://localhost:5173
DATA_DIR=./data

# Security: create these values before the first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_to_a_long_unique_password
TOKEN_PEPPER=CHANGE_ME_generate_at_least_32_random_bytes
SESSION_SECRET=CHANGE_ME_generate_at_least_32_random_bytes

# multi-auth | oauth | bearer | api-key | basic | none
AUTH_MODE=multi-auth
ENABLE_OAUTH=true
ENABLE_BEARER=true
ENABLE_API_KEY=true
ENABLE_BASIC=true
ENABLE_NO_AUTH=false

# Allow new user registration via /auth/register (true/false)
ENABLE_REGISTRATION=true

# Development-only credentials. Replace before use; leave empty to disable.
TEST_BEARER_TOKEN=
TEST_BEARER_SCOPES=memory:read,memory:write
TEST_API_KEY=
TEST_API_KEY_SCOPES=memory:read,memory:write

OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300

# Only set true when the Node server is behind a trusted local reverse proxy such as cloudflared.
# Never use this setting when arbitrary clients can reach the Node port directly.
TRUST_PROXY=false

# Optional allowlist for CIMD (Client ID Metadata Document) fetches.
# Empty means allow public HTTPS hostnames only after DNS/IP checks; use a semicolon-separated list to restrict it.
CIMD_ALLOWED_HOSTS=
